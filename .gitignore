CerebroNexus.Rcheck
CerebroNexus_*.tar.gz
.direnv
.Rhistory
.Rprofile
result
vignettes/*.crb
docs
.Rproj.user
*.Rproj
tests/smoke/
.playwright-mcp/
tmp/

# local per-project memory (Loci brain) — personal, never tracked
.loci/

# shinytest2 snapshot comparison artifacts
tests/testthat/_snaps/**/*.new.png

# large public raw data — auto-downloaded by the build scripts, reproducible via
# data-raw/DATASETS.md, not tracked (only the built .crb ship)
data-raw/vdj_10x/
data-raw/vdj_10x_dextramer/
data-raw/slidetags/
data-raw/xenium/

# R's default graphics-device dump, produced by tests/vignettes that plot; a
# stray artifact, never source
Rplots.pdf
**/Rplots.pdf
inst/private-data/linked-view-shares.sqlite
# The generic `docs` rule above would otherwise hide benchmark documentation.
!tests/bench/docs/
!tests/bench/docs/**

# Benchmark evidence is versioned; transient logs and working data are not.
tests/bench/results/**/logs/
tests/bench/study-work/
tests/bench/scratch/
tests/viewer-validation/result/
paper/figures/output/
